# 复制为 .env 后按需修改（docker compose 自动读同目录的 .env；.env 不提交）。
# 每一项都能被 docker-compose.yml 里的 ${VAR:-默认值} 读到，不填就用默认值。

# ---- 必填：镜像（构建机 / CI 推送，部署机只 pull）----
# 必须带版本 tag，不要用 latest：升级就换这里，再 docker compose pull && docker compose up -d
NIFE_REMOTE_IMAGE=registry.example.com/nife-remote-server:0.0.1

# ---- 可选（默认值见右）----

# 日志级别（默认 info）
# RUST_LOG=info

# 证书 SAN（默认 nife-remote,localhost）：可不填，客户端只按指纹校验、不看域名；
# 仅首次生成证书时生效，已有证书则忽略。别为了改它去删证书——指纹变了所有客户端要重编
# NIFE_REMOTE_CERT_NAMES=relay.example.com,1.2.3.4

# 每台被控端最多几个控制端同时连接（默认 4）
# NIFE_REMOTE_MAX_SESSIONS=4

# 同一来源（IPv4 / IPv6 的 /64）最多同时几条连接（默认 128）；很多被控端共用出口 IP 时调大
# NIFE_REMOTE_MAX_CONNS_PER_IP=128

# 同一来源（IPv4 / IPv6 的 /48）10 分钟内最多分配几个新控制码（默认 30）
# NIFE_REMOTE_NEW_CODES_PER_IP=30

# 同一来源（IPv4 / IPv6 的 /64）一分钟内最多向同一台被控端发起几次连接（默认 6，不低于 MAX_SESSIONS）
# NIFE_REMOTE_CONNECTS_PER_MINUTE=6

# 自己的证书（默认自动生成到 /data）
# NIFE_REMOTE_CERT=/data/cert.pem
# NIFE_REMOTE_KEY=/data/key.pem

# SQLite 数据库：固定控制码绑定表，别删（默认在证书旁边）
# NIFE_REMOTE_DB=/data/nife-remote.db

# ---- 账号服务（server/auth，可选；不填也起得来，只是登录用不了）----
# 镜像同上面一样：构建机推送，部署机只 pull
NIFE_REMOTE_AUTH_IMAGE=registry.example.com/nife-remote-auth:0.0.1
# 对外端口（建议放在 Caddy 后面反代 /auth/* 和 /health）
# NIFE_REMOTE_AUTH_PORT=8080
# 登录凭证有效期（秒，默认 30 天）
# NIFE_REMOTE_AUTH_TOKEN_TTL=2592000
# open 允许注册，closed 只能登录已有账号
# NIFE_REMOTE_AUTH_REGISTRATION=open
# NIFE_REMOTE_AUTH_MAX_USERS=1000
# 密码摘要迭代次数（调大更安全、登录更慢，老账号登录后自动升级）
# NIFE_REMOTE_AUTH_ROUNDS=200000
# 服务器上一个账号都没有时自动建的账号（登录后请改密码；设成空不建）
# NIFE_REMOTE_AUTH_DEFAULT_USER=niferemote
# NIFE_REMOTE_AUTH_DEFAULT_PASSWORD=niferemote
