# 复制为 .env 后修改，docker compose 会自动读取
# 网页控制台的镜像：由构建机 / CI 构建并推送，部署机只拉这个镜像（带版本 tag，不要用 latest）
# 例：NIFE_REMOTE_WEB_IMAGE=registry.example.com/nife-remote-web:0.0.1
# NIFE_REMOTE_WEB_IMAGE=registry.example.com/nife-remote-web:0.0.1
NIFE_REMOTE_SERVER=relay.example.com:4433
NIFE_REMOTE_SERVER_FP=
# NIFE_REMOTE_NAME=Nife Remote Web
# NIFE_REMOTE_WEB_PASSWORD=
# NIFE_REMOTE_WEB_PORT=8080
# NIFE_REMOTE_WEB_CERT_NAMES=localhost,nas.lan,192.168.1.10
