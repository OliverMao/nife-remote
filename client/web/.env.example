# 复制为 .env 后按需修改（docker compose 自动读同目录的 .env；.env 不提交）。

# ---- 必填 1：镜像（构建机 / CI 推送，部署机只 pull）----
NIFE_REMOTE_WEB_IMAGE=mirror.naig.us/nife-remote-web:0.0.1

# ---- 必填 2：中转服务器地址和证书指纹 ----
# 指纹：在跑中转服务器的机器上 docker compose logs nife-remote | grep fingerprint
NIFE_REMOTE_SERVER=relay.example.com:4433
NIFE_REMOTE_SERVER_FP=

# ---- 可选 ----

# 被控端托盘里“谁在控制”显示的名称（默认 Nife Remote Web）
# NIFE_REMOTE_NAME=Nife Remote Web

# 访问密码，浏览器弹登录框、用户名随意（留空则不校验，任何人能访问）
# NIFE_REMOTE_WEB_PASSWORD=

# 对外端口（默认 8080，HTTP 和 HTTPS 共用）
# NIFE_REMOTE_WEB_PORT=8080

# 自动生成 HTTPS 证书的 SAN（默认 localhost），逗号分隔
# NIFE_REMOTE_WEB_CERT_NAMES=localhost,nas.lan,192.168.1.10
